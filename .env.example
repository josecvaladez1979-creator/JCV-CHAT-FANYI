# ═══════════════════════════════════════════════
# BASE DE DATOS
# ═══════════════════════════════════════════════
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jcv_fanyi"

# ═══════════════════════════════════════════════
# SESIONES (obligatorias en producción, mínimo 32 caracteres y DISTINTAS entre sí)
# Genera cada una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ═══════════════════════════════════════════════
# APP
# Si el frontend se sirve desde este mismo servidor, CORS_ORIGINS puede quedar vacío.
# ═══════════════════════════════════════════════
CORS_ORIGINS=
PORT=3000
# Dirección pública de tu app con https (para volver del pago). Ejemplo: https://tudominio.com
APP_URL=

# ═══════════════════════════════════════════════
# TRADUCCIÓN CON IA (apagada por defecto)
# Para activarla: FEATURE_TRANSLATION=on y definir las demás.
# La tarifa vive en server/catalog.ts (TARIFFS), no aquí.
# TEXT_MODEL debe ser un identificador que exista en tu proveedor
# (en SiliconFlow, por ejemplo, el de Qwen3-32B es "Qwen/Qwen3-32B").
# ═══════════════════════════════════════════════
FEATURE_TRANSLATION=off
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
TEXT_MODEL=

# ═══════════════════════════════════════════════
# ADMINISTRADOR INICIAL (solo para `npm run db:seed`)
# Sin valores por defecto. En producción además: ALLOW_SEED_IN_PRODUCTION=yes
# ═══════════════════════════════════════════════
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ═══════════════════════════════════════════════
# PAGOS. El cobro con Stripe está APAGADO: además de estas claves hay que cambiar
# CHECKOUT_ENABLED a true en server/catalog.ts. Empieza SIEMPRE con claves de prueba
# (sk_test_...). El webhook se registra en Stripe como: <APP_URL>/api/webhooks/stripe
# y escucha: checkout.session.completed y checkout.session.async_payment_succeeded.
# Precios mensuales de los planes empresariales, creados en MXN en Stripe.
# ═══════════════════════════════════════════════
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_CORPORATE=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

MERCADOPAGO_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
