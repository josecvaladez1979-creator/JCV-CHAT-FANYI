generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════
enum Role {
  USER
  ADMIN
  ORG_OWNER
  ORG_MEMBER
}

// Planes empresariales vigentes. Los antiguos B2B_15D / B2B_1M / B2B_1Y
// y todos los B2C_* fueron retirados.
enum B2BPlanId {
  BASIC
  PROFESSIONAL
  CORPORATE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  TRIAL
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MERCADOPAGO
}

enum InvoiceStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum MessageModule {
  FREEMIUM
  B2C
  B2B
}

enum CreditTxType {
  TOPUP
  USAGE
  REFUND
  ADJUSTMENT
  EXPIRY
}

enum UsageFeature {
  TEXT_TRANSLATION
  AUDIO
  AUDIO_TRANSLATION
  VOICE_CALL
  VOICE_CALL_TRANSLATION
  VIDEO_CALL
  VIDEO_CALL_TRANSLATION
}

// ═══════════════════════════════════════════════
// MODELOS PRINCIPALES
// ═══════════════════════════════════════════════

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  passwordHash      String
  name              String
  avatar            String?
  preferredLanguage String         @default("es")
  role              Role           @default(USER)
  orgId             String?
  org               Organization?  @relation(fields: [orgId], references: [id], onDelete: SetNull)

  // Autenticación
  refreshTokens     RefreshToken[]

  // Saldo prepagado
  wallet            Wallet?

  // Mensajes
  messages          Message[]
  channelMemberships ChannelMember[]
  reactionsGiven    MessageReaction[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orgId])
  @@index([email])
}

model Organization {
  id              String           @id @default(cuid())
  companyName     String
  rfc             String?
  members         User[]
  subscriptionB2B SubscriptionB2B?
  wallet          Wallet?
  messages        Message[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════
// SALDO PREPAGADO (recargas de 100, 200, 500 y 1000 MXN)
// Con vigencia: al vencer, lo no consumido se pierde (movimiento EXPIRY).
// Importes siempre en CENTAVOS de MXN, como enteros.
// ═══════════════════════════════════════════════
model Wallet {
  id           String              @id @default(cuid())
  userId       String?             @unique
  user         User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  orgId        String?             @unique
  org          Organization?       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  balanceCents Int                 @default(0)
  expiresAt    DateTime?           // vencimiento del saldo; lo no consumido se pierde
  currency     String              @default("MXN")
  transactions CreditTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// Libro de movimientos. Una fila por abono o cargo; no se edita ni se borra.
// amountCents: positivo = abono, negativo = cargo.
model CreditTransaction {
  id                String        @id @default(cuid())
  walletId          String
  wallet            Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type              CreditTxType
  amountCents       Int
  balanceAfterCents Int
  provider          String        // STRIPE | MERCADOPAGO | PAYPAL | INTERNAL
  providerRef       String        // id externo o clave interna; evita acreditar dos veces
  feature           UsageFeature?
  metadata          Json?
  createdAt         DateTime      @default(now())

  @@unique([provider, providerRef])
  @@index([walletId, createdAt])
}

// ═══════════════════════════════════════════════
// B2B — Suscripciones empresariales (por organización)
// ═══════════════════════════════════════════════
model SubscriptionB2B {
  id          String              @id @default(cuid())
  orgId       String              @unique
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan        B2BPlanId
  provider    PaymentProvider
  externalId  String?             @unique
  status      SubscriptionStatus  @default(PENDING)
  seats       Int                 @default(5)
  autoRenew   Boolean             @default(true)
  startsAt    DateTime            @default(now())
  expiresAt   DateTime
  invoices    Invoice[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([orgId])
  @@index([externalId])
}

// ═══════════════════════════════════════════════
// INVOICES — Facturación
// Nace PENDING: solo un webhook verificado puede marcarla PAID.
// ═══════════════════════════════════════════════
model Invoice {
  id          String            @id @default(cuid())
  amount      Int               // centavos
  currency    String            @default("mxn")
  provider    PaymentProvider
  providerRef String?
  status      InvoiceStatus     @default(PENDING)
  b2bId       String?
  b2b         SubscriptionB2B?  @relation(fields: [b2bId], references: [id], onDelete: SetNull)
  orgId       String?           // trazabilidad contable sin depender de la suscripción
  paidAt      DateTime?
  createdAt   DateTime          @default(now())

  @@unique([provider, providerRef])
  @@index([b2bId])
  @@index([orgId])
}

// ═══════════════════════════════════════════════
// MESSAGES — Persistencia real
// ═══════════════════════════════════════════════
model Message {
  id                  String         @id @default(cuid())
  channelId           String
  senderId            String
  sender              User           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  orgId               String?
  org                 Organization?  @relation(fields: [orgId], references: [id], onDelete: SetNull)
  module              MessageModule  @default(FREEMIUM)
  text                String
  originalText        String?
  translations        Json?          // { "es": "...", "en": "..." }
  sourceLanguage      String         @default("es")
  isE2EE              Boolean        @default(false)
  encryptedPayload    Json?
  isAudio             Boolean        @default(false)
  audioDuration       Float?
  audioBase64         String?        @db.Text
  aiModel             String?
  translationAccuracy String?
  reactions           Json?          // en desuso: ahora se usa MessageReaction
  reactionRecords     MessageReaction[]
  createdAt           DateTime       @default(now())

  @@index([channelId, createdAt])
  @@index([senderId])
  @@index([orgId])
}

// ═══════════════════════════════════════════════
// CHANNELS — Salas de chat
// ═══════════════════════════════════════════════
model Channel {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?
  isPrivate       Boolean  @default(false)
  isE2EE          Boolean  @default(false)
  e2eePassphrase  String?        // EN DESUSO: el servidor nunca debe guardar claves de cifrado
  createdById     String?
  members         ChannelMember[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════
// WEBHOOK EVENTS — Idempotencia
// ═══════════════════════════════════════════════
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventId])
}

// ═══════════════════════════════════════════════
// CONTROL FISCAL — ventas y gastos para tu contador (SAT / RESICO)
// Sin llaves foráneas a propósito: los registros fiscales no deben cambiar
// ni borrarse si se elimina un usuario o una organización.
// No calcula impuestos: solo conserva los datos que tu contador necesita.
// ═══════════════════════════════════════════════
enum SaleKind {
  TOPUP
  B2B_SUBSCRIPTION
  CONTRACT_TRANSLATION
  REFUND
  OTHER
}

enum CfdiStatus {
  PENDING
  ISSUED
  INCLUDED_IN_GLOBAL
  CANCELED
  NOT_APPLICABLE
}

enum ExpenseCategory {
  HOSTING
  DATABASE
  AI
  PAYMENT_FEES
  DOMAIN
  TOOLS
  OTHER
}

model SaleRecord {
  id                 String     @id @default(cuid())
  kind               SaleKind
  provider           String
  providerRef        String
  userId             String?
  orgId              String?
  customerName       String?
  customerRfc        String?
  customerEmail      String?
  currency           String     @default("MXN")
  netCents           Int        // subtotal sin IVA
  ivaCents           Int        @default(0)
  totalCents         Int        // lo que pagó el cliente (negativo en reembolsos)
  gatewayFeeCents    Int?       // comisión de la pasarela, si se conoce
  taxpayerRegistered Boolean    // si estabas registrado en el SAT al vender
  paymentMethod      String?
  paidAt             DateTime   // fecha de cobro efectivo
  cfdiStatus         CfdiStatus
  cfdiUuid           String?    @unique
  cfdiFolio          String?
  cfdiIssuedAt       DateTime?
  globalInvoiceRef   String?
  refundOfId         String?
  metadata           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([provider, providerRef])
  @@index([paidAt])
  @@index([cfdiStatus])
}

model ExpenseRecord {
  id             String          @id @default(cuid())
  spentAt        DateTime
  supplier       String
  concept        String
  category       ExpenseCategory
  currency       String          @default("MXN")
  originalCents  Int?            // importe en la moneda original, si no es MXN
  fxRate         Float?          // tipo de cambio usado
  amountMxnCents Int
  ivaCents       Int             @default(0)
  hasCfdi        Boolean         @default(false)
  cfdiUuid       String?
  receiptNote    String?
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([spentAt])
}


// ═══════════════════════════════════════════════
// CHAT — miembros de canal y reacciones
// ═══════════════════════════════════════════════
model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
